// automation.bd_lookupExistingProfile
// Triggered by a Leads workflow rule (on create / import).
// Argument mapping in the workflow: leadId -> Leads > Lead Id
//
// Looks up the lead's email on Brilliant Directories (igopanama.com) and
// writes back BD_Member_ID, BD_Profile_URL, Verified_Member, Current_Plan and
// Top_Category / Sub_category / Sub_sub_category (+ the 4 Visit fields).
//
// Every exit path logs an "info" line so failures show up in the
// function's execution logs instead of failing silently.
void automation.bd_lookupExistingProfile(Int leadId)
{
// Paste your BD API key here. Do not commit the real key to git.
apiKey = "PASTE_BD_API_KEY_HERE";
bdBase = "https://www.igopanama.com";
headerMap = Map();
headerMap.put("X-Api-Key",apiKey);
leadMap = zoho.crm.getRecordById("Leads",leadId);
if(leadMap == null || leadMap.get("id") == null)
{
	info "Lead " + leadId + " not found / not readable: " + leadMap;
	return;
}
email = leadMap.get("Email");
if(email == null || email.trim() == "")
{
	info "Lead " + leadId + " has no email - skipping";
	return;
}
normalizedEmail = email.trim().toLowerCase();
try
{
	u = null;
	bdUserId = null;
	// "get"    = direct lookup by email field (no HTML parsing)
	// "search" = old method: search, scrape data-token, then user/get/{id}
	for each  method in {"get","search"}
	{
		if(u == null)
		{
			rawMessage = null;
			if(method == "get")
			{
				resp = invokeurl
				[
					url :bdBase + "/api/v2/user/get?property=email&property_value=" + encodeUrl(normalizedEmail)
					type :GET
					headers:headerMap
					detailed:true
				];
			}
			else
			{
				paramMap = Map();
				paramMap.put("q",normalizedEmail);
				searchResp = invokeurl
				[
					url :bdBase + "/api/v2/user/search"
					type :POST
					parameters:paramMap
					headers:headerMap
					detailed:true
				];
				searchText = searchResp.get("responseText").toString();
				info "BD user/search -> HTTP " + searchResp.get("responseCode");
				if(!searchText.startsWith("{"))
				{
					info "BD search returned non-JSON (firewall/Cloudflare block or API down?): " + searchText.left(500);
					return;
				}
				searchBody = searchText.toMap();
				if(searchBody.get("status") != "success" || searchBody.get("total_members").toString() == "0")
				{
					info "No BD member found for " + normalizedEmail + ". Response: " + searchText.left(500);
					return;
				}
				htmlBlob = searchBody.get("message").toString();
				tokenKey = "data-token=\"";
				tokenStart = htmlBlob.indexOf(tokenKey);
				if(tokenStart == -1)
				{
					info "Could not parse user_id from BD search HTML for " + normalizedEmail + ". HTML starts: " + htmlBlob.left(500);
					return;
				}
				tokenStart = tokenStart + tokenKey.length();
				tokenEnd = htmlBlob.indexOf("\"",tokenStart);
				bdUserId = htmlBlob.subString(tokenStart,tokenEnd);
				resp = invokeurl
				[
					url :bdBase + "/api/v2/user/get/" + bdUserId
					type :GET
					headers:headerMap
					detailed:true
				];
			}
			respCode = resp.get("responseCode");
			respText = resp.get("responseText").toString();
			info "BD user/get (" + method + ") -> HTTP " + respCode;
			if(respCode == 401 || respCode == 403)
			{
				info "BD rejected the API key (HTTP " + respCode + "). Check the key is active and allowed to use user/get and user/search. Body: " + respText.left(500);
				return;
			}
			if(respText.startsWith("{"))
			{
				respBody = respText.toMap();
				if(respBody.get("status") == "success")
				{
					rawMessage = respBody.get("message");
				}
				else
				{
					info "BD user/get (" + method + ") not successful: " + respText.left(500);
				}
			}
			else
			{
				info "BD user/get (" + method + ") returned non-JSON: " + respText.left(500);
			}
			// BD returns "message" as a list of users or a single user map
			if(rawMessage != null)
			{
				rawMessage = rawMessage.toString();
				candidates = List();
				if(rawMessage.startsWith("["))
				{
					for each  item in rawMessage.toJSONList()
					{
						candidates.add(item.toString().toMap());
					}
				}
				else if(rawMessage.startsWith("{"))
				{
					candidates.add(rawMessage.toMap());
				}
				for each  c in candidates
				{
					e = c.get("email");
					if(u == null && e != null && e.toString().trim().toLowerCase() == normalizedEmail)
					{
						u = c;
					}
				}
				if(u == null)
				{
					info "BD user/get (" + method + ") returned users but none with email " + normalizedEmail;
				}
			}
		}
	}
	if(u == null)
	{
		info "No BD user matched " + normalizedEmail;
		return;
	}
	updateMap = Map();
	updateMap.put("BD_Member_ID",u.get("user_id").toString());
	filenameVal = u.get("filename");
	if(filenameVal != null && filenameVal.toString().trim() != "")
	{
		filenameVal = filenameVal.toString().trim();
		if(filenameVal.startsWith("http"))
		{
			profileUrl = filenameVal;
		}
		else if(filenameVal.startsWith("/"))
		{
			profileUrl = bdBase + filenameVal;
		}
		else
		{
			profileUrl = bdBase + "/" + filenameVal;
		}
		updateMap.put("BD_Profile_URL",profileUrl);
	}
	planVal = null;
	subSchema = u.get("subscription_schema");
	if(subSchema != null && subSchema.toString().startsWith("{"))
	{
		planVal = subSchema.toString().toMap().get("subscription_name");
	}
	if(planVal != null && planVal.toString().trim() != "")
	{
		updateMap.put("Current_Plan",planVal.toString().trim());
	}
	verifiedVal = u.get("verified");
	if(verifiedVal != null && verifiedVal.toString() == "1")
	{
		updateMap.put("Verified_Member","YES - Verified");
	}
	else
	{
		updateMap.put("Verified_Member","NO - Not Verified");
	}
	// ---------- Top / Sub / Sub-sub categories ----------
	// Only for the 5 pillars:
	//   Relocate, Stay, Live, Experience -> Sub_category, Sub_sub_category
	//   Visit -> Sub_category = "Tourism License (ATP Class)"
	//            Sub_sub_category = children of "Tourism License (ATP Class)"
	//            Location_Setting / Key_Amenities / Good_For / Style_Vibe =
	//            children of the BD sub category with the same name
	// Wrapped in its own try so a category problem never blocks the ID/URL/verified update.
	try 
	{
		bdUserId = u.get("user_id").toString();
		professionId = ifnull(u.get("profession_id"),"").toString();
		crmTopCategory = ifnull(leadMap.get("Top_Category"),"").toString().trim();
		pillars = {"Visit","Relocate","Stay","Live","Experience"};
		// BD Visit sub category name (lowercase) -> CRM field for its sub-sub categories
		visitFieldMap = Map();
		visitFieldMap.put("tourism license (atp class)","Sub_sub_category");
		visitFieldMap.put("location & setting","Location_Setting");
		visitFieldMap.put("key amenities","Key_Amenities");
		visitFieldMap.put("good for","Good_For");
		visitFieldMap.put("style & vibe","Style_Vibe");
		// Top category (pillar) from BD, falling back to the CRM value
		bdTop = "";
		if(professionId != "" && professionId != "0")
		{
			profResp = invokeurl
			[
				url :bdBase + "/api/v2/list_professions/get/" + professionId
				type :GET
				headers:headerMap
			];
			if(profResp.get("status") == "success")
			{
				profMsg = profResp.get("message").toString();
				if(profMsg.startsWith("["))
				{
					profMsg = profMsg.toJSONList().get(0).toString();
				}
				bdTop = ifnull(profMsg.toMap().get("name"),"").toString().replaceAll("&amp;","&").trim();
			}
			else
			{
				info "BD list_professions/get/" + professionId + " failed: " + profResp;
			}
		}
		pillar = "";
		for each  p in pillars
		{
			if(p.equalsIgnoreCase(bdTop) || (bdTop == "" && p.equalsIgnoreCase(crmTopCategory)))
			{
				pillar = p;
			}
		}
		info "BD top category='" + bdTop + "', CRM top category='" + crmTopCategory + "', pillar='" + pillar + "'";
		if(pillar == "")
		{
			info "Top category is not one of the 5 pillars - skipping sub categories";
		}
		else
		{
			if(crmTopCategory == "")
			{
				updateMap.put("Top_Category",pillar);
			}
			// Member's selected categories (rel_services)
			relResp = invokeurl
			[
				url :bdBase + "/api/v2/rel_services/get?property=user_id&property_value=" + bdUserId + "&limit=100"
				type :GET
				headers:headerMap
			];
			memberServiceIds = List();
			if(relResp.get("status") == "success")
			{
				relMsg = relResp.get("message").toString();
				relList = List();
				if(relMsg.startsWith("["))
				{
					relList = relMsg.toJSONList();
				}
				else if(relMsg.startsWith("{"))
				{
					relList.add(relMsg);
				}
				for each  r in relList
				{
					sid = r.toString().toMap().get("service_id");
					if(sid != null && !memberServiceIds.contains(sid.toString()))
					{
						memberServiceIds.add(sid.toString());
					}
				}
			}
			else
			{
				info "No BD sub categories for user " + bdUserId + ": " + relResp;
			}
			// Resolve service names + parents (pass 1: member's services, pass 2: their parents)
			serviceCache = Map();
			toFetch = memberServiceIds;
			for each  passNo in {1,2}
			{
				nextFetch = List();
				for each  sid in toFetch
				{
					if(!serviceCache.containsKey(sid))
					{
						svcResp = invokeurl
						[
							url :bdBase + "/api/v2/list_services/get/" + sid
							type :GET
							headers:headerMap
						];
						if(svcResp.get("status") == "success")
						{
							svcMsg = svcResp.get("message").toString();
							if(svcMsg.startsWith("["))
							{
								svcMsg = svcMsg.toJSONList().get(0).toString();
							}
							svc = svcMsg.toMap();
							svcName = ifnull(svc.get("name"),"").toString().replaceAll("&amp;","&").replaceAll("&#039;","'").trim();
							masterId = ifnull(svc.get("master_id"),"0").toString();
							if(masterId == "")
							{
								masterId = "0";
							}
							svcEntry = Map();
							svcEntry.put("name",svcName);
							svcEntry.put("master_id",masterId);
							serviceCache.put(sid,svcEntry);
							if(masterId != "0" && !serviceCache.containsKey(masterId) && !nextFetch.contains(masterId))
							{
								nextFetch.add(masterId);
							}
						}
						else
						{
							info "BD list_services/get/" + sid + " failed: " + svcResp;
						}
					}
				}
				toFetch = nextFetch;
			}
			// Split into sub categories and sub-sub categories
			subNames = List();
			// each item: {"name": sub-sub name, "parent": parent sub name}
			subSubs = List();
			for each  sid in memberServiceIds
			{
				if(serviceCache.containsKey(sid))
				{
					svcEntry = serviceCache.get(sid);
					if(svcEntry.get("master_id") == "0")
					{
						if(!subNames.contains(svcEntry.get("name")))
						{
							subNames.add(svcEntry.get("name"));
						}
					}
					else
					{
						parentName = "";
						if(serviceCache.containsKey(svcEntry.get("master_id")))
						{
							parentName = serviceCache.get(svcEntry.get("master_id")).get("name");
						}
						ss = Map();
						ss.put("name",svcEntry.get("name"));
						ss.put("parent",parentName);
						subSubs.add(ss);
					}
				}
			}
			info "BD subs=" + subNames + " sub-subs=" + subSubs;
			if(pillar == "Visit")
			{
				updateMap.put("Sub_category","Tourism License (ATP Class)");
				visitValues = Map();
				for each  ss in subSubs
				{
					parentKey = ss.get("parent").toLowerCase();
					if(visitFieldMap.containsKey(parentKey))
					{
						fieldName = visitFieldMap.get(parentKey);
						vals = ifnull(visitValues.get(fieldName),List());
						if(!vals.contains(ss.get("name")))
						{
							vals.add(ss.get("name"));
						}
						visitValues.put(fieldName,vals);
					}
					else
					{
						info "Visit sub-sub '" + ss.get("name") + "' has unmapped parent '" + ss.get("parent") + "'";
					}
				}
				for each  fieldName in visitValues.keys()
				{
					updateMap.put(fieldName,visitValues.get(fieldName));
				}
			}
			else
			{
				subName = "";
				if(subNames.size() > 0)
				{
					subName = subNames.get(0);
				}
				else if(subSubs.size() > 0)
				{
					subName = subSubs.get(0).get("parent");
				}
				if(subName != "")
				{
					updateMap.put("Sub_category",subName);
				}
				subSubVals = List();
				for each  ss in subSubs
				{
					if((subName == "" || ss.get("parent").equalsIgnoreCase(subName)) && !subSubVals.contains(ss.get("name")))
					{
						subSubVals.add(ss.get("name"));
					}
				}
				if(subSubVals.size() > 0)
				{
					updateMap.put("Sub_sub_category",subSubVals);
				}
			}
		}
	}
	catch (catError)
	{
		info "BD category lookup error for user " + u.get("user_id") + ": " + catError;
	}
	updateResp = zoho.crm.updateRecord("Leads",leadId,updateMap);
	info "Update sent: " + updateMap;
	info "CRM update response: " + updateResp;
}
catch (lookupError)
{
	info "BD lookup error for lead " + leadId + ": " + lookupError;
}
}
