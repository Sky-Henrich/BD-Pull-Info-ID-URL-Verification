// standalone.bd_getCategoryFields
// Create as a STANDALONE function (Setup > Developer Hub > Functions > New Function,
// category "Standalone") named bd_getCategoryFields with these arguments:
//   bdUserId (String), professionId (String), crmTopCategory (String), apiKey (String)
// Return type: string (a JSON map of CRM fields; the caller converts it with toMap()).
// Called from automation.bd_lookupExistingProfile.
//
// Reads the member's BD Top Category (list_professions), Sub / Sub-sub
// categories (rel_services -> list_services) and returns a map of CRM Lead
// fields to update. Only the 5 pillars are handled:
//   Relocate, Stay, Live, Experience -> Sub_category, Sub_sub_category
//   Visit -> Sub_category = "Tourism License (ATP Class)"
//            Sub_sub_category = children of "Tourism License (ATP Class)"
//            Location_Setting / Key_Amenities / Good_For / Style_Vibe =
//            children of the BD sub category with the same name
string standalone.bd_getCategoryFields(String bdUserId, String professionId, String crmTopCategory, String apiKey)
{
result = Map();
bdBase = "https://www.igopanama.com";
headerMap = Map();
headerMap.put("X-Api-Key",apiKey);
pillars = {"Visit","Relocate","Stay","Live","Experience"};
// BD Visit sub category name (lowercase) -> CRM field for its sub-sub categories
visitFieldMap = Map();
visitFieldMap.put("tourism license (atp class)","Sub_sub_category");
visitFieldMap.put("location & setting","Location_Setting");
visitFieldMap.put("key amenities","Key_Amenities");
visitFieldMap.put("good for","Good_For");
visitFieldMap.put("style & vibe","Style_Vibe");
try
{
	// ---------- Top category (pillar) ----------
	bdTop = "";
	if(professionId != null && professionId != "" && professionId != "0")
	{
		profResp = invokeurl
		[
			url :bdBase + "/api/v2/list_professions/get/" + professionId
			type :GET
			headers:headerMap
		];
		if(profResp.get("status") == "success")
		{
			profMsg = profResp.get("message").toString();
			if(profMsg.startsWith("["))
			{
				profMsg = profMsg.toJSONList().get(0).toString();
			}
			bdTop = ifnull(profMsg.toMap().get("name"),"").toString().replaceAll("&amp;","&").trim();
		}
		else
		{
			info "BD list_professions/get/" + professionId + " failed: " + profResp;
		}
	}
	pillar = "";
	for each  p in pillars
	{
		if(p.equalsIgnoreCase(bdTop) || (bdTop == "" && crmTopCategory != null && p.equalsIgnoreCase(crmTopCategory.trim())))
		{
			pillar = p;
		}
	}
	info "BD top category='" + bdTop + "', CRM top category='" + crmTopCategory + "', pillar='" + pillar + "'";
	if(pillar == "")
	{
		info "Top category is not one of the 5 pillars - skipping sub categories";
		return result.toString();
	}
	if(crmTopCategory == null || crmTopCategory.trim() == "")
	{
		result.put("Top_Category",pillar);
	}
	// ---------- Member's selected categories (rel_services) ----------
	relResp = invokeurl
	[
		url :bdBase + "/api/v2/rel_services/get?property=user_id&property_value=" + bdUserId + "&limit=100"
		type :GET
		headers:headerMap
	];
	if(relResp.get("status") != "success")
	{
		info "No BD sub categories for user " + bdUserId + ": " + relResp;
		return result.toString();
	}
	relMsg = relResp.get("message").toString();
	relList = List();
	if(relMsg.startsWith("["))
	{
		relList = relMsg.toJSONList();
	}
	else if(relMsg.startsWith("{"))
	{
		relList.add(relMsg);
	}
	toFetch = List();
	for each  r in relList
	{
		sid = r.toString().toMap().get("service_id");
		if(sid != null && !toFetch.contains(sid.toString()))
		{
			toFetch.add(sid.toString());
		}
	}
	memberServiceIds = toFetch;
	// ---------- Resolve service names + parents (2 passes: services, then parents) ----------
	serviceCache = Map();
	for each  passNo in {1,2}
	{
		nextFetch = List();
		for each  sid in toFetch
		{
			if(!serviceCache.containsKey(sid))
			{
				svcResp = invokeurl
				[
					url :bdBase + "/api/v2/list_services/get/" + sid
					type :GET
					headers:headerMap
				];
				if(svcResp.get("status") == "success")
				{
					svcMsg = svcResp.get("message").toString();
					if(svcMsg.startsWith("["))
					{
						svcMsg = svcMsg.toJSONList().get(0).toString();
					}
					svc = svcMsg.toMap();
					svcName = ifnull(svc.get("name"),"").toString().replaceAll("&amp;","&").replaceAll("&#039;","'").trim();
					masterId = ifnull(svc.get("master_id"),"0").toString();
					if(masterId == "")
					{
						masterId = "0";
					}
					entry = Map();
					entry.put("name",svcName);
					entry.put("master_id",masterId);
					serviceCache.put(sid,entry);
					if(masterId != "0" && !serviceCache.containsKey(masterId) && !nextFetch.contains(masterId))
					{
						nextFetch.add(masterId);
					}
				}
				else
				{
					info "BD list_services/get/" + sid + " failed: " + svcResp;
				}
			}
		}
		toFetch = nextFetch;
	}
	// ---------- Split into sub categories and sub-sub categories ----------
	subNames = List();
	// each item: {"name": sub-sub name, "parent": parent sub name}
	subSubs = List();
	for each  sid in memberServiceIds
	{
		if(serviceCache.containsKey(sid))
		{
			entry = serviceCache.get(sid);
			if(entry.get("master_id") == "0")
			{
				if(!subNames.contains(entry.get("name")))
				{
					subNames.add(entry.get("name"));
				}
			}
			else
			{
				parentName = "";
				if(serviceCache.containsKey(entry.get("master_id")))
				{
					parentName = serviceCache.get(entry.get("master_id")).get("name");
				}
				ss = Map();
				ss.put("name",entry.get("name"));
				ss.put("parent",parentName);
				subSubs.add(ss);
			}
		}
	}
	info "BD subs=" + subNames + " sub-subs=" + subSubs;
	if(pillar == "Visit")
	{
		result.put("Sub_category","Tourism License (ATP Class)");
		visitValues = Map();
		for each  ss in subSubs
		{
			parentKey = ss.get("parent").toLowerCase();
			if(visitFieldMap.containsKey(parentKey))
			{
				fieldName = visitFieldMap.get(parentKey);
				vals = ifnull(visitValues.get(fieldName),List());
				if(!vals.contains(ss.get("name")))
				{
					vals.add(ss.get("name"));
				}
				visitValues.put(fieldName,vals);
			}
			else
			{
				info "Visit sub-sub '" + ss.get("name") + "' has unmapped parent '" + ss.get("parent") + "'";
			}
		}
		for each  fieldName in visitValues.keys()
		{
			result.put(fieldName,visitValues.get(fieldName));
		}
	}
	else
	{
		subName = "";
		if(subNames.size() > 0)
		{
			subName = subNames.get(0);
		}
		else if(subSubs.size() > 0)
		{
			subName = subSubs.get(0).get("parent");
		}
		if(subName != "")
		{
			result.put("Sub_category",subName);
		}
		subSubVals = List();
		for each  ss in subSubs
		{
			if((subName == "" || ss.get("parent").equalsIgnoreCase(subName)) && !subSubVals.contains(ss.get("name")))
			{
				subSubVals.add(ss.get("name"));
			}
		}
		if(subSubVals.size() > 0)
		{
			result.put("Sub_sub_category",subSubVals);
		}
	}
}
catch (catError)
{
	info "BD category lookup error for user " + bdUserId + ": " + catError;
}
info "Category fields: " + result;
return result.toString();
}
