// schedule.bd_syncImportedLeads
// Zoho does not run "on create" workflow rules for leads added by CSV import,
// so this scheduled function catches them instead (and any older lead that
// was never checked).
//
// Needs a checkbox field on Leads: "BD Lookup Done" (API name BD_Lookup_Done).
// Setup > Automation > Schedules > Create Schedule > Function > Write your own
// Name: bd_syncImportedLeads, run every 1 hour.
//
// Every run: takes up to batchSize leads where BD_Lookup_Done is unchecked,
// runs automation.bd_lookupExistingProfile on those with an email, then ticks
// BD_Lookup_Done so each lead is only looked up once (matched or not).
// Large imports are worked through in batches, one batch per run.
void schedule.bd_syncImportedLeads()
{
// Keep each run well inside Zoho's execution time limit (~1-2 s per lead)
batchSize = 100;
looked = 0;
marked = 0;
leads = zoho.crm.searchRecords("Leads","(BD_Lookup_Done:equals:false)",1,batchSize);
if(leads == null || leads.size() == 0)
{
	info "BD sync: nothing to do";
	return;
}
for each  lead in leads
{
	leadId = lead.get("id").toLong();
	bdId = ifnull(lead.get("BD_Member_ID"),"").toString().trim();
	email = ifnull(lead.get("Email"),"").toString().trim();
	if(bdId == "" && email != "")
	{
		try
		{
			automation.bd_lookupExistingProfile(leadId);
			looked = looked + 1;
		}
		catch (syncError)
		{
			info "BD sync error for lead " + leadId + ": " + syncError;
		}
	}
	doneMap = Map();
	doneMap.put("BD_Lookup_Done",true);
	zoho.crm.updateRecord("Leads",leadId,doneMap);
	marked = marked + 1;
}
info "BD sync: looked up " + looked + " lead(s), marked " + marked + " as done. Run again for the next batch.";
}
